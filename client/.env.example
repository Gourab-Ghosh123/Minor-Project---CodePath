# CodePath Frontend Environment Variables

# Backend API base URL
# Production Render backend:
VITE_API_URL=https://minor-project-codepath.onrender.com/api

# For local development with server running on localhost:5000:
# Leave VITE_API_URL empty/commented out to use Vite dev proxy, or specify:
# VITE_API_URL=http://localhost:5000/api
